{
  "name": "ai-2d-asset-studio",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:site": "npm run build && node scripts/build-hosted.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint apps/web/src apps/worker packages tests",
    "format": "prettier --write apps/web/src packages tests *.ts *.js docs README.md"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@vitejs/plugin-react": "4.7.0",
    "fflate": "0.8.2",
    "immer": "10.1.3",
    "lucide-react": "0.468.0",
    "pixi.js": "8.14.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "zod": "3.25.76",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.16",
    "@types/node": "22.19.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.1",
    "prettier": "^3.6.2",
    "tailwindcss": "4.1.16",
    "typescript-eslint": "8.46.3",
    "vitest": "3.2.4"
  }
}
